// Valores monetários em CENTAVOS (Int). Datas de lançamento são DATE (sem hora/fuso).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CHECKING
  SAVINGS
  WALLET
  INVESTMENT
  OTHER
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionStatus {
  PENDING
  PAID
}

/// Situação de uma previsão (lançamento estimado).
/// OPEN: conta nos saldos/relatórios pelo valor que ainda falta abater.
/// CLOSED: encerrada pelo usuário. EXPIRED: a data passou sem ser encerrada.
enum ForecastState {
  OPEN
  CLOSED
  EXPIRED
}

enum Frequency {
  WEEKLY
  MONTHLY
  YEARLY
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  accounts     Account[]
  categories   Category[]
  cards        CreditCard[]
  transactions  Transaction[]
  recurrences   Recurrence[]
  reportFilters ReportFilter[]
  suggestions   Suggestion[]
}

/// O que aconteceu com uma notificação de banco lida no celular.
enum SuggestionStatus {
  /// Lançamento novo sugerido, esperando o usuário aceitar ou descartar.
  PENDING
  /// O usuário aceitou (virou lançamento).
  ACCEPTED
  /// O usuário descartou.
  DISMISSED
  /// Já existia um lançamento pendente igual: foi marcado como pago.
  AUTO_PAID
  /// Já existia um lançamento igual e pago: nada a fazer.
  ALREADY_EXISTS
  /// Não é movimentação (propaganda, fatura fechou, compra negada...).
  IGNORED
  /// A IA falhou ou não está configurada; dá para tentar de novo.
  ERROR
}

/// Notificação de banco lida no celular, interpretada pela IA e comparada com os lançamentos.
model Suggestion {
  id       String           @id @default(cuid())
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status   SuggestionStatus
  /// Motivo (ignorada) ou erro.
  reason   String?

  /// Notificação como chegou.
  app      String
  appName  String?
  title    String?
  text     String
  postedAt DateTime
  /// Evita processar a mesma notificação duas vezes.
  hash     String

  /// Lançamento interpretado pela IA.
  type         TransactionType?
  channel      String?
  amount       Int?
  date         DateTime?        @db.Date
  merchant     String?
  description  String?
  accountId    String?
  cardId       String?
  categoryId   String?
  installments Int?
  confidence   Float?

  /// Lançamento ligado: o que recebeu baixa, o que já existia, ou o criado ao aceitar.
  transactionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, hash])
  @@index([userId, status])
}

/// Filtro preferido de um relatório (ou do painel): abre sozinho ao entrar na tela.
model ReportFilter {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// cashflow, categories, forecasts, counterparts, dashboard
  report    String
  /// Filtros da tela (sem o período), no formato que o app entende.
  params    Json
  updatedAt DateTime @updatedAt

  @@unique([userId, report])
}

model Account {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           AccountType @default(CHECKING)
  initialBalance Int         @default(0)
  color          String?
  archived       Boolean     @default(false)
  createdAt      DateTime    @default(now())

  transactions Transaction[] @relation("TxAccount")
  transfersIn  Transaction[] @relation("TxToAccount")
  cards        CreditCard[]

  @@index([userId])
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  kind      CategoryKind
  color     String?
  icon      String?
  createdAt DateTime     @default(now())

  transactions Transaction[]

  @@index([userId])
}

model CreditCard {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  limit            Int?
  closingDay       Int
  dueDay           Int
  /// true: compra feita NO dia do fechamento vai para a próxima fatura.
  closingDayInNext Boolean  @default(true)
  paymentAccountId String
  paymentAccount   Account  @relation(fields: [paymentAccountId], references: [id], onDelete: Restrict)
  /// Últimos 4 dígitos (para reconhecer o cartão nas notificações do banco).
  lastDigits       String?
  color            String?
  archived         Boolean  @default(false)
  createdAt        DateTime @default(now())

  invoices     Invoice[]
  transactions Transaction[]

  @@index([userId])
}

model Invoice {
  id          String     @id @default(cuid())
  cardId      String
  card        CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  /// Primeiro dia do mês em que a fatura fecha.
  refMonth    DateTime   @db.Date
  closingDate DateTime   @db.Date
  dueDate     DateTime   @db.Date
  createdAt   DateTime   @default(now())

  items    Transaction[] @relation("InvoiceItems")
  payments Transaction[] @relation("InvoicePayments")

  @@unique([cardId, refMonth])
}

/// Modelo de lançamento fixo. As ocorrências são materializadas em Transaction
/// até `generatedUntil` (horizonte de 12 meses, estendido automaticamente).
model Recurrence {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  frequency      Frequency
  interval       Int             @default(1)
  startDate      DateTime        @db.Date
  endDate        DateTime?       @db.Date
  generatedUntil DateTime        @db.Date
  type           TransactionType
  description    String
  amount         Int
  categoryId     String?
  accountId      String?
  toAccountId    String?
  cardId         String?
  notes          String?
  /// Fixo de previsão: as ocorrências são geradas como previsões.
  isForecast     Boolean         @default(false)
  /// Cada ocorrência gerada ganha a sua contrapartida.
  withCounterpart Boolean        @default(false)
  createdAt      DateTime        @default(now())

  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  description String
  /// Sempre positivo; o sinal vem do tipo.
  amount      Int
  date        DateTime          @db.Date
  paidAt      DateTime?         @db.Date
  notes       String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  accountId   String?
  account     Account? @relation("TxAccount", fields: [accountId], references: [id], onDelete: Cascade)
  toAccountId String?
  toAccount   Account? @relation("TxToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)

  cardId    String?
  card      CreditCard? @relation(fields: [cardId], references: [id], onDelete: Cascade)
  invoiceId String?
  invoice   Invoice?    @relation("InvoiceItems", fields: [invoiceId], references: [id], onDelete: Cascade)

  /// Preenchido quando o lançamento é o pagamento de uma fatura.
  paysInvoiceId String?
  paysInvoice   Invoice? @relation("InvoicePayments", fields: [paysInvoiceId], references: [id], onDelete: SetNull)

  installmentGroupId String?
  installmentNumber  Int?
  installmentTotal   Int?

  recurrenceId String?
  recurrence   Recurrence? @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)

  /// Id da operação no arquivo importado (OFX FITID). Usado para conciliar novas importações.
  externalId   String?
  /// Nome do lançamento como veio no arquivo importado (OFX MEMO).
  externalName String?

  /// Previsão: valor estimado, abatido pelos lançamentos reais vinculados (`abatements`).
  isForecast    Boolean        @default(false)
  forecastState ForecastState?
  /// Lançamento real: a previsão que ele abate.
  forecastId    String?
  forecast      Transaction?   @relation("ForecastAbatements", fields: [forecastId], references: [id], onDelete: SetNull)
  abatements    Transaction[]  @relation("ForecastAbatements")

  /// Contrapartida: lançamento de tipo oposto que zera o de origem (ex.: compra para um amigo
  /// que vai pagar). Preenchido na contrapartida, apontando para a origem.
  counterpartOfId String?      @unique
  counterpartOf   Transaction? @relation("Counterpart", fields: [counterpartOfId], references: [id], onDelete: Cascade)
  counterpart     Transaction? @relation("Counterpart")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([cardId, externalId])
  @@index([invoiceId])
  @@index([paysInvoiceId])
  @@index([recurrenceId])
  @@index([installmentGroupId])
  @@index([forecastId])
  @@index([userId, isForecast])
}
