# Copie para .env.prod e troque os valores. O .env.prod NÃO vai para o Git.
POSTGRES_USER=sewwallet
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=sewwallet

# Pelo menos 32 caracteres.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32+-caracteres

# Endereço da API como o celular enxerga (IP ou nome do PC no Tailscale).
PUBLIC_API_URL=http://100.x.y.z:3001

# Deixe true só até criar seu usuário; depois volte para false e reinicie a API.
ALLOW_REGISTRATION=true

BACKUP_KEEP_DAYS=30
BACKUP_HOUR=03

# IA que interpreta as notificações dos bancos (API no formato da OpenAI). Vazio = desligada.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
